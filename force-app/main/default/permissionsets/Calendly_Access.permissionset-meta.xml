<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lets an advisor call Calendly through the Calendly named credential and read their own
  Calendly Event Type URI. The external credential principal access (Calendly_EC / CalendlyPAT)
  is granted in Setup > Permission Sets > External Credential Principal Access, because the
  credential itself is created by hand (see integrations/calendly.md).
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Calendly Access</label>
    <description>Use of the Calendly named credential and the advisor's Calendly Event Type URI.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <editable>true</editable>
        <field>User.Calendly_Event_Type_URI__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
