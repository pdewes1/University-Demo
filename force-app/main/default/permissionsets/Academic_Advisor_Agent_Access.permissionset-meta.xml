<?xml version="1.0" encoding="UTF-8"?>
<!--
  Grants an advisor the Apex actions behind the Advisor Agent.
  Access to the agent itself (BotDefinition Academic_Advisor_Student_Success) was granted
  on this permission set in Setup > Permission Sets > Agent Access; add it there after deploy.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Academic Advisor Agent Access</label>
    <description>Access to the Academic Advisor Student Success agent and the Apex actions it uses.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>CalendlyService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CreateCalendlyBookingLinkAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CreateStudentTaskAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DraftStudentEmailAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>LogStudentNoteAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>Student360DataAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>StudentAccess</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UpdateStudentRecordAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
