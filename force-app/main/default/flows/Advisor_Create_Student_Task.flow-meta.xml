    <decisions>
        <defaultConnector>
            <targetReference>Refuse</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not allowed</defaultConnectorLabel>
        <label>Advisor owns the student?</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <name>Is_Allowed</name>
        <rules>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>accessAllowed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Subject</targetReference>
            </connector>
            <label>Yes</label>
            <name>Is_Allowed_Yes</name>
        </rules>
    </decisions>
    <decisions>
        <defaultConnector>
            <targetReference>Need_Subject</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No subject</defaultConnectorLabel>
        <label>Subject given?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <name>Has_Subject</name>
        <rules>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fHasSubject</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
            <label>Yes</label>
            <name>Has_Subject_Yes</name>
        </rules>
    </decisions>
    <description>Agent action: creates a follow-up task for the advisor on one of their students. Calls CheckStudentAccessAction first and creates nothing unless the advisor owns the student.</description>
    <formulas>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!subject}))</expression>
        <name>fHasSubject</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>LEFT({!subject}, 255)</expression>
        <name>fSubject</name>
    </formulas>
    <formulas>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!dueDate}), TODAY() + 3, {!dueDate})</expression>
        <name>fDueDate</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>CASE(LOWER({!priority}), "high", "High", "low", "Low", "Normal")</expression>
        <name>fPriority</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Task \"" &amp; {!fSubject} &amp; "\" created for " &amp; {!accessStudentName} &amp; ", due " &amp; TEXT({!fDueDate}) &amp; "."</expression>
        <name>fCreatedMessage</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Could not create the task: " &amp; {!$Flow.FaultMessage}</expression>
        <name>fFaultMessage</name>
    </formulas>
