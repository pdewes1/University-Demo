            <label>Yes</label>
            <name>Has_Changes_Yes</name>
        </rules>
    </decisions>
    <description>Agent action: updates stage, level, email, phone or mobile phone on one of the advisor's students. Calls CheckStudentAccessAction first. Fields left blank are not changed; no other field can be.</description>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!studentStage}), {!student.Student_Stage__c}, {!studentStage})</expression>
        <name>f_studentStage</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!studentLevel}), {!student.Student_Level__c}, {!studentLevel})</expression>
        <name>f_studentLevel</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!email}), {!student.Email}, {!email})</expression>
        <name>f_email</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!phone}), {!student.Phone}, {!phone})</expression>
        <name>f_phone</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mobilePhone}), {!student.MobilePhone}, {!mobilePhone})</expression>
        <name>f_mobilePhone</name>
    </formulas>
    <formulas>
        <dataType>Boolean</dataType>
        <expression>NOT(AND(ISBLANK({!studentStage}), ISBLANK({!studentLevel}), ISBLANK({!email}), ISBLANK({!phone}), ISBLANK({!mobilePhone})))</expression>
        <name>fAnyChange</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>LEFT(IF(ISBLANK({!studentStage}), "", "Student Stage, ") &amp; IF(ISBLANK({!studentLevel}), "", "Student Level, ") &amp; IF(ISBLANK({!email}), "", "Email, ") &amp; IF(ISBLANK({!phone}), "", "Phone, ") &amp; IF(ISBLANK({!mobilePhone}), "", "Mobile Phone, "), LEN(IF(ISBLANK({!studentStage}), "", "Student Stage, ") &amp; IF(ISBLANK({!studentLevel}), "", "Student Level, ") &amp; IF(ISBLANK({!email}), "", "Email, ") &amp; IF(ISBLANK({!phone}), "", "Phone, ") &amp; IF(ISBLANK({!mobilePhone}), "", "Mobile Phone, ")) - 2)</expression>
        <name>fChangedList</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Updated " &amp; {!accessStudentName} &amp; ": " &amp; {!fChangedList} &amp; "."</expression>
        <name>fUpdatedMessage</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Could not update the student record: " &amp; {!$Flow.FaultMessage}</expression>
        <name>fFaultMessage</name>
    </formulas>
