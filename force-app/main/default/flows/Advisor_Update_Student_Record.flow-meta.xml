    <description>Agent action: updates allow-listed fields on one of the advisor's students. Calls the Advisor_Check_Student_Access subflow first. Fields left blank are not changed; no other field can be.</description>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!studentStage}), {!student.Student_Stage__c}, {!studentStage})</expression>
        <name>f_studentStage</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!studentLevel}), {!student.Student_Level__c}, {!studentLevel})</expression>
        <name>f_studentLevel</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!level}), TEXT({!student.Level__c}), {!level})</expression>
        <name>f_level</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!languages}), {!student.Languages__c}, {!languages})</expression>
        <name>f_languages</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!email}), {!student.Email}, {!email})</expression>
        <name>f_email</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!phone}), {!student.Phone}, {!phone})</expression>
        <name>f_phone</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mobilePhone}), {!student.MobilePhone}, {!mobilePhone})</expression>
        <name>f_mobilePhone</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!title}), {!student.Title}, {!title})</expression>
        <name>f_title</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!description}), {!student.Description}, {!description})</expression>
        <name>f_description</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mailingStreet}), {!student.MailingStreet}, {!mailingStreet})</expression>
        <name>f_mailingStreet</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mailingCity}), {!student.MailingCity}, {!mailingCity})</expression>
        <name>f_mailingCity</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mailingState}), {!student.MailingState}, {!mailingState})</expression>
        <name>f_mailingState</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mailingPostalCode}), {!student.MailingPostalCode}, {!mailingPostalCode})</expression>
        <name>f_mailingPostalCode</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!mailingCountry}), {!student.MailingCountry}, {!mailingCountry})</expression>
        <name>f_mailingCountry</name>
    </formulas>
    <formulas>
        <dataType>Boolean</dataType>
        <expression>NOT(AND(ISBLANK({!studentStage}), ISBLANK({!studentLevel}), ISBLANK({!level}), ISBLANK({!languages}), ISBLANK({!email}), ISBLANK({!phone}), ISBLANK({!mobilePhone}), ISBLANK({!title}), ISBLANK({!description}), ISBLANK({!mailingStreet}), ISBLANK({!mailingCity}), ISBLANK({!mailingState}), ISBLANK({!mailingPostalCode}), ISBLANK({!mailingCountry})))</expression>
        <name>fAnyChange</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!studentStage}), "", "Student Stage, ") &amp; IF(ISBLANK({!studentLevel}), "", "Student Level, ") &amp; IF(ISBLANK({!level}), "", "Level, ") &amp; IF(ISBLANK({!languages}), "", "Languages, ") &amp; IF(ISBLANK({!email}), "", "Email, ") &amp; IF(ISBLANK({!phone}), "", "Phone, ") &amp; IF(ISBLANK({!mobilePhone}), "", "Mobile Phone, ") &amp; IF(ISBLANK({!title}), "", "Title, ") &amp; IF(ISBLANK({!description}), "", "Description, ") &amp; IF(ISBLANK({!mailingStreet}), "", "Mailing Street, ") &amp; IF(ISBLANK({!mailingCity}), "", "Mailing City, ") &amp; IF(ISBLANK({!mailingState}), "", "Mailing State, ") &amp; IF(ISBLANK({!mailingPostalCode}), "", "Mailing Postal Code, ") &amp; IF(ISBLANK({!mailingCountry}), "", "Mailing Country, ")</expression>
        <name>fChangedRaw</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>LEFT({!fChangedRaw}, LEN({!fChangedRaw}) - 2)</expression>
        <name>fChangedList</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Updated " &amp; {!accessStudentName} &amp; ": " &amp; {!fChangedList} &amp; "."</expression>
        <name>fUpdatedMessage</name>
    </formulas>
    <formulas>
        <dataType>String</dataType>
        <expression>"Could not update the student record: " &amp; {!$Flow.FaultMessage}</expression>
        <name>fFaultMessage</name>
    </formulas>
