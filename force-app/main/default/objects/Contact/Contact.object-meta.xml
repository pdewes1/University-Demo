<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Makes Student_Record_Page the org-default desktop record page for Contact (students). -->
    <actionOverrides>
        <actionName>View</actionName>
        <comment>Student record page with the Student 360 card from Data 360</comment>
        <content>Student_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <!-- Highlights panel on the student record: Student ID, program, stage, modality, graduation term, contact preference. -->
    <compactLayoutAssignment>Student_Compact</compactLayoutAssignment>
    <!-- Students are visible only to their owner (the assigned advisor). Admins with View All Data still see all. -->
    <externalSharingModel>Private</externalSharingModel>
    <sharingModel>Private</sharingModel>
    <!-- The standard Update Record action can write any field the advisor can edit, so this keeps the
         Banner Student ID and the advisor assignment out of reach for the Academic Advisor profile. -->
    <validationRules>
        <fullName>Advisors_Keep_Student_ID_and_Owner</fullName>
        <active>true</active>
        <description>Advisors (and the Advisor Agent acting as them) can't change a student's Student ID or reassign the student. Student ID comes from Banner and advisor assignment comes from the nightly load.</description>
        <errorConditionFormula>AND($Profile.Name = "Academic Advisor", OR(ISCHANGED(OwnerId), ISCHANGED(Student_ID__c)))</errorConditionFormula>
        <errorMessage>Student ID and the assigned advisor can't be changed here. They come from Banner and the advisor assignment process.</errorMessage>
    </validationRules>
</CustomObject>
